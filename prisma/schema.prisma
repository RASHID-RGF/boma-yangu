generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                String                @id @default(uuid())
  email                             String                @unique
  phone                             String?
  passwordHash                      String
  firstName                         String
  lastName                          String
  role                              String                @default("TENANT")
  idNumber                          String?
  kraPin                            String?
  isVerified                        Boolean               @default(false)
  isTwoFactorEnabled                Boolean               @default(false)
  twoFactorSecret                   String?
  avatarUrl                         String?
  lastLoginAt                       DateTime?
  createdAt                         DateTime              @default(now())
  updatedAt                         DateTime              @updatedAt
  activities                        ActivityLog[]
  CaretakerAssignment               CaretakerAssignment[]
  documents                         Document[]
  invoices                          Invoice[]
  leases                            Lease[]
  loginRecords                      LoginRecord[]
  assignedMaintenanceRequests       MaintenanceRequest[]  @relation("MaintenanceAssignee")
  reportedMaintenanceRequests       MaintenanceRequest[]  @relation("MaintenanceReporter")
  receivedMessages                  Message[]             @relation("MessageReceiver")
  sentMessages                      Message[]             @relation("MessageSender")
  notifications                     Notification[]
  payments                          Payment[]
  Property_Property_managerIdToUser Property[]            @relation("Property_managerIdToUser")
  ownedProperties                   Property[]            @relation("PropertyOwner")
  sessions                          Session[]
  tenants                           Tenant[]
}

model Property {
  id                            String                @id @default(uuid())
  name                          String
  description                   String?
  type                          String                @default("APARTMENT")
  status                        String                @default("VACANT")
  address                       String
  city                          String
  state                         String?
  country                       String                @default("Kenya")
  latitude                      Float?
  longitude                     Float?
  totalUnits                    Int                   @default(0)
  occupiedUnits                 Int                   @default(0)
  monthlyIncome                 Float                 @default(0)
  expenses                      Float                 @default(0)
  images                        String[]
  mpesaPaybill                  String?
  mpesaAccountName              String?
  mpesaTillNumber               String?
  mpesaPhone                    String?
  palplussChannelId             String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  ownerId                       String
  managerId                     String?
  activities                    ActivityLog[]
  CaretakerAssignment           CaretakerAssignment[]
  documents                     Document[]
  User_Property_managerIdToUser User?                 @relation("Property_managerIdToUser", fields: [managerId], references: [id])
  owner                         User                  @relation("PropertyOwner", fields: [ownerId], references: [id])
  units                         Unit[]
}

model Unit {
  id                  String               @id @default(uuid())
  unitNumber          String
  description         String?
  floorNumber         Int?
  monthlyRent         Float                @default(0)
  baseRent            Float?
  depositAmount       Float                @default(0)
  utilityCharges      Float                @default(0)
  waterCharge         Float                @default(0)
  electricityCharge   Float                @default(0)
  garbageCharge       Float                @default(0)
  serviceCharge       Float                @default(0)
  internetCharge      Float                @default(0)
  parkingCharge       Float                @default(0)
  status              String               @default("VACANT")
  bedrooms            Int                  @default(1)
  bathrooms           Int                  @default(1)
  size                Float?
  images              String[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  propertyId          String
  invoices            Invoice[]
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]
  payments            Payment[]
  messages            Message[]
  tenants             Tenant[]
  property            Property             @relation(fields: [propertyId], references: [id])
}

model Tenant {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  email               String?
  phone               String
  idNumber            String?
  kraPin              String?
  emergencyName       String?
  emergencyPhone      String?
  emergencyRelation   String?
  moveInDate          DateTime?
  moveOutDate         DateTime?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  unitId              String?
  userId              String?
  documents           Document[]
  invoices            Invoice[]
  lease               Lease?
  maintenanceRequests MaintenanceRequest[]
  payments            Payment[]
  messages            Message[]
  unit                Unit?                @relation(fields: [unitId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
}

model Lease {
  id                 String     @id @default(uuid())
  startDate          DateTime
  endDate            DateTime
  monthlyRent        Float
  depositAmount      Float      @default(0)
  terms              String?
  status             String     @default("ACTIVE")
  isDigitalSignature Boolean    @default(false)
  signedDocumentUrl  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  tenantId           String     @unique
  unitId             String
  createdById        String
  documents          Document[]
  createdBy          User       @relation(fields: [createdById], references: [id])
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  unit               Unit       @relation(fields: [unitId], references: [id])
}

model Payment {
  id                String   @id @default(uuid())
  amount            Float
  description       String?
  status            String   @default("PENDING")
  method            String
  transactionCode   String?
  receiptNumber     String?
  checkoutRequestId String?
  phoneNumber       String?
  paymentDate       DateTime @default(now())
  recordedAt        DateTime @default(now())
  isPartial         Boolean  @default(false)
  balanceBefore     Float?
  balanceAfter      Float?
  qrCodeUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenantId          String
  unitId            String?
  recordedById      String
  invoiceId         String?
  invoice           Invoice? @relation(fields: [invoiceId], references: [id])
  recordedBy        User     @relation(fields: [recordedById], references: [id])
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  unit              Unit?    @relation(fields: [unitId], references: [id])
}

model Invoice {
  id                String     @id @default(uuid())
  invoiceNumber     String     @unique
  month             Int
  year              Int
  rentAmount        Float
  waterCharge       Float      @default(0)
  electricityCharge Float      @default(0)
  garbageCharge     Float      @default(0)
  serviceCharge     Float      @default(0)
  internetCharge    Float      @default(0)
  parkingCharge     Float      @default(0)
  otherCharges      Float      @default(0)
  totalAmount       Float
  amountPaid        Float      @default(0)
  balance           Float
  dueDate           DateTime
  status            String     @default("DRAFT")
  notes             String?
  pdfUrl            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tenantId          String
  unitId            String
  createdById       String
  documents         Document[]
  createdBy         User       @relation(fields: [createdById], references: [id])
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  unit              Unit       @relation(fields: [unitId], references: [id])
  payments          Payment[]
}

model MaintenanceRequest {
  id            String        @id @default(uuid())
  title         String
  description   String
  priority      String        @default("MEDIUM")
  status        String        @default("REPORTED")
  images        String[]
  estimatedCost Float?
  actualCost    Float?
  scheduledDate DateTime?
  completedDate DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenantId      String?
  unitId        String?
  reportedById  String
  assignedToId  String?
  activities    ActivityLog[]
  documents     Document[]
  assignedTo    User?         @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])
  reportedBy    User          @relation("MaintenanceReporter", fields: [reportedById], references: [id])
  tenant        Tenant?       @relation(fields: [tenantId], references: [id])
  unit          Unit?         @relation(fields: [unitId], references: [id])
}

model Notification {
  id              String    @id @default(uuid())
  type            String
  title           String
  message         String
  isRead          Boolean   @default(false)
  readAt          DateTime?
  sentViaEmail    Boolean   @default(false)
  sentViaSms      Boolean   @default(false)
  sentViaWhatsApp Boolean   @default(false)
  createdAt       DateTime  @default(now())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
}

model Document {
  id            String              @id @default(uuid())
  name          String
  type          String
  url           String
  size          Int?
  mimeType      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  uploadedById  String
  propertyId    String?
  tenantId      String?
  leaseId       String?
  invoiceId     String?
  maintenanceId String?
  invoice       Invoice?            @relation(fields: [invoiceId], references: [id])
  lease         Lease?              @relation(fields: [leaseId], references: [id])
  maintenance   MaintenanceRequest? @relation(fields: [maintenanceId], references: [id])
  property      Property?           @relation(fields: [propertyId], references: [id])
  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  uploadedBy    User                @relation(fields: [uploadedById], references: [id])
}

model Message {
  id         String    @id @default(uuid())
  subject    String
  content    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  senderId   String
  receiverId String?
  tenantId   String?
  unitId     String?
  receiver   User?     @relation("MessageReceiver", fields: [receiverId], references: [id])
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  unit       Unit?     @relation(fields: [unitId], references: [id])
  sender     User      @relation("MessageSender", fields: [senderId], references: [id])
}

model ActivityLog {
  id            String              @id @default(uuid())
  action        String
  description   String?
  entityType    String
  entityId      String?
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime            @default(now())
  userId        String
  propertyId    String?
  maintenanceId String?
  maintenance   MaintenanceRequest? @relation(fields: [maintenanceId], references: [id])
  property      Property?           @relation(fields: [propertyId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  userId     String
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model LoginRecord {
  id        String   @id @default(uuid())
  userId    String
  email     String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Backup {
  id          String    @id @default(uuid())
  filename    String
  size        Int?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model CaretakerAssignment {
  id          String   @id
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  caretakerId String
  propertyId  String
  User        User     @relation(fields: [caretakerId], references: [id])
  Property    Property @relation(fields: [propertyId], references: [id])

  @@unique([caretakerId, propertyId])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
