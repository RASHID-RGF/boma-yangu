generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  LANDLORD
  MANAGER
  CARETAKER
  TENANT
}

enum PropertyType {
  APARTMENT
  BEDSITTER
  SINGLE_ROOM
  MAISONETTE
  COMMERCIAL
  VILLA
  TOWNHOUSE
}

enum PropertyStatus {
  OCCUPIED
  VACANT
  UNDER_MAINTENANCE
}

enum UnitStatus {
  OCCUPIED
  VACANT
  UNDER_MAINTENANCE
  RESERVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum PaymentMethod {
  MPESA_STK_PUSH
  MPESA_PAYBILL
  MPESA_TILL_NUMBER
  BANK_TRANSFER
  CASH
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum MaintenanceStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum NotificationType {
  RENT_DUE
  PAYMENT_RECEIVED
  MAINTENANCE_UPDATE
  LEASE_EXPIRY
  ANNOUNCEMENT
  INVOICE_GENERATED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(TENANT)
  idNumber      String?
  kraPin        String?
  isVerified    Boolean   @default(false)
  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret   String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedProperties   Property[]    @relation("PropertyOwner")
  managedProperties Property[]    @relation("PropertyManager")
  assignments       CaretakerAssignment[]
  tenants           Tenant[]
  payments          Payment[]
  invoices          Invoice[]
  reportedMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceReporter")
  assignedMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceAssignee")
  sessions          Session[]
  notifications     Notification[]
  leases            Lease[]
  documents         Document[]
  activities        ActivityLog[]
  sentMessages      Message[]     @relation("MessageSender")
  receivedMessages  Message[]     @relation("MessageReceiver")
}

model Property {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        PropertyType @default(APARTMENT)
  status      PropertyStatus @default(VACANT)
  address     String
  city        String
  state       String?
  country     String       @default("Kenya")
  latitude    Float?
  longitude   Float?
  totalUnits  Int          @default(0)
  occupiedUnits Int        @default(0)
  monthlyIncome Float      @default(0)
  expenses    Float        @default(0)
  images      String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ownerId     String
  owner       User         @relation("PropertyOwner", fields: [ownerId], references: [id])
  managerId   String?
  manager     User?        @relation("PropertyManager", fields: [managerId], references: [id])

  units       Unit[]
  caretakerAssignments CaretakerAssignment[]
  documents   Document[]
  activities  ActivityLog[]
}

model Unit {
  id            String     @id @default(cuid())
  unitNumber    String
  description   String?
  floorNumber   Int?
  monthlyRent   Float
  depositAmount Float      @default(0)
  utilityCharges Float     @default(0)
  waterCharge   Float      @default(0)
  electricityCharge Float  @default(0)
  garbageCharge Float      @default(0)
  serviceCharge Float      @default(0)
  internetCharge Float     @default(0)
  parkingCharge Float      @default(0)
  status        UnitStatus @default(VACANT)
  bedrooms      Int        @default(1)
  bathrooms     Int        @default(1)
  size          Float?
  images        String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenants       Tenant[]
  leases        Lease[]
  payments      Payment[]
  invoices      Invoice[]
  maintenanceRequests MaintenanceRequest[]
}

model Tenant {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  phone         String
  idNumber      String?
  kraPin        String?
  emergencyName String?
  emergencyPhone String?
  emergencyRelation String?
  moveInDate    DateTime?
  moveOutDate   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])

  lease         Lease?
  payments      Payment[]
  invoices      Invoice[]
  maintenanceRequests MaintenanceRequest[]
  documents     Document[]
}

model Lease {
  id            String      @id @default(cuid())
  startDate     DateTime
  endDate       DateTime
  monthlyRent   Float
  depositAmount Float       @default(0)
  terms         String?
  status        LeaseStatus @default(ACTIVE)
  isDigitalSignature Boolean @default(false)
  signedDocumentUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenantId      String      @unique
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  unitId        String
  unit          Unit        @relation(fields: [unitId], references: [id])
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])

  documents     Document[]
}

model Payment {
  id            String        @id @default(cuid())
  amount        Float
  description   String?
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  transactionCode String?     @unique
  receiptNumber String?       @unique
  paymentDate   DateTime      @default(now())
  recordedAt    DateTime      @default(now())
  isPartial     Boolean       @default(false)
  balanceBefore Float?
  balanceAfter  Float?
  qrCodeUrl     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  unitId        String
  unit          Unit          @relation(fields: [unitId], references: [id])
  recordedById  String
  recordedBy    User          @relation(fields: [recordedById], references: [id])
  invoiceId     String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  month         Int
  year          Int
  rentAmount    Float
  waterCharge   Float         @default(0)
  electricityCharge Float     @default(0)
  garbageCharge Float         @default(0)
  serviceCharge Float         @default(0)
  internetCharge Float        @default(0)
  parkingCharge Float         @default(0)
  otherCharges  Float         @default(0)
  totalAmount   Float
  amountPaid    Float         @default(0)
  balance       Float
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  unitId        String
  unit          Unit          @relation(fields: [unitId], references: [id])
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])

  payments      Payment[]
  documents     Document[]
}

model MaintenanceRequest {
  id            String            @id @default(cuid())
  title         String
  description   String
  priority      String            @default("MEDIUM")
  status        MaintenanceStatus @default(REPORTED)
  images        String[]
  estimatedCost Float?
  actualCost    Float?
  scheduledDate DateTime?
  completedDate DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  unitId        String
  unit          Unit              @relation(fields: [unitId], references: [id])
  reportedById  String
  reportedBy    User              @relation("MaintenanceReporter", fields: [reportedById], references: [id])
  assignedToId  String?
  assignedTo    User?             @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])

  documents     Document[]
  activities    ActivityLog[]
}

model CaretakerAssignment {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  caretakerId String
  caretaker   User      @relation(fields: [caretakerId], references: [id])
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([caretakerId, propertyId])
}

model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  title           String
  message         String
  isRead          Boolean          @default(false)
  readAt          DateTime?
  sentViaEmail    Boolean          @default(false)
  sentViaSms      Boolean          @default(false)
  sentViaWhatsApp Boolean          @default(false)
  createdAt       DateTime         @default(now())

  userId          String
  user            User             @relation(fields: [userId], references: [id])
}

model Document {
  id          String    @id @default(cuid())
  name        String
  type        String
  url         String
  size        Int?
  mimeType    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  leaseId     String?
  lease       Lease?    @relation(fields: [leaseId], references: [id])
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  maintenanceId String?
  maintenance MaintenanceRequest? @relation(fields: [maintenanceId], references: [id])
}

model Message {
  id        String    @id @default(cuid())
  subject   String
  content   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
}

model ActivityLog {
  id          String    @id @default(cuid())
  action      String
  description String?
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  maintenanceId String?
  maintenance MaintenanceRequest? @relation(fields: [maintenanceId], references: [id])
}

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  userId      String
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Backup {
  id        String    @id @default(cuid())
  filename  String
  size      Int?
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
  completedAt DateTime?
}
