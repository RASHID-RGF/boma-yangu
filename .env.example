# MongoDB Atlas connection string (Prisma + MongoDB)
# Replace USERNAME, PASSWORD, CLUSTER, and DATABASE with your Atlas values.
# Atlas connection strings look like:
# mongodb+srv://USERNAME:PASSWORD@atlas-vmhnu9-shard-0.mongodb.net/DATABASE?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@atlas-vmhnu9-shard-0.mongodb.net/test?retryWrites=true&w=majority"

